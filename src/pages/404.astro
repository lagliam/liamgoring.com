---
import Layout from '../layouts/Layout.astro';
---

<Layout noindex title="Page not found" description="There is no page at this address on liamgoring.com.">
  <section class="not-found">
    <div class="container">
      <h1 class="not-found__title">Page not found</h1>

      <dl class="argument">
        <div class="argument__line">
          <dt><span aria-hidden="true">P1</span><span class="sr-only">Premise 1</span></dt>
          <dd>You asked for a page.</dd>
        </div>
        <div class="argument__line">
          <dt><span aria-hidden="true">P2</span><span class="sr-only">Premise 2</span></dt>
          <dd>The page doesn’t exist.</dd>
        </div>
        <div class="argument__line argument__line--conclusion">
          <dt><span aria-hidden="true">∴</span><span class="sr-only">Therefore</span></dt>
          <dd>Absence of evidence is, here, evidence of absence.</dd>
        </div>
      </dl>

      <p class="not-found__next">
        The link may be old, or the address mistyped. The homepage is a sound place to start again.
      </p>

      <a class="action action--primary" href="/">Go to the homepage</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: var(--section-space) 0;
    min-height: 70vh;
  }

  .not-found__title {
    font-size: var(--step-3);
    margin-bottom: 2.5rem;
  }

  .argument {
    max-width: 36rem;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .argument__line {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    align-items: baseline;
    padding-block: 0.4rem;
  }

  .argument__line dt {
    font-size: var(--step-0);
    font-style: italic;
    color: var(--rule);
  }

  .argument__line dd {
    color: var(--ink);
  }

  /* the line drawn under the premises, before the conclusion */
  .argument__line--conclusion {
    margin-top: 0.5rem;
    padding-top: 0.9rem;
    border-top: 2px solid var(--rule);
  }

  .argument__line--conclusion dt {
    font-size: var(--step-2);
    font-style: normal;
  }

  .not-found__next {
    max-width: 40ch;
    margin: 2.5rem 0 2rem;
    color: var(--ink-muted);
  }

  @media (max-width: 520px) {
    .argument {
      font-size: var(--step-1);
    }

    .argument__line {
      grid-template-columns: 2.25rem 1fr;
      column-gap: 0.75rem;
    }

    .argument__line--conclusion dt {
      font-size: var(--step-1);
    }
  }
</style>
