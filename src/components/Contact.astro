---
import '../styles/contact.css';
---

<section id="contact" class="contact-section">
  <div class="container">
    <h2>Get In Touch</h2>
    <p class="section-subtitle">
      I'd love to hear from you — whether it's a collaboration, an opportunity, or just a friendly hello.
    </p>

    <div class="contact-links">

      <a
        href="https://www.linkedin.com/in/liam-goring-833b8614a"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-badge linkedin-badge"
        aria-label="Connect on LinkedIn (opens in new tab)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.722-2.004 1.418-.103.249-.129.597-.129.946v5.441h-3.554s.047-8.733 0-9.637h3.554v1.364c.429-.646 1.199-1.566 2.922-1.566 2.135 0 3.751 1.395 3.751 4.402v5.437zM5.337 8.855c-1.144 0-1.915-.762-1.915-1.715 0-.952.77-1.715 1.948-1.715 1.178 0 1.915.763 1.915 1.715 0 .953-.737 1.715-1.948 1.715zm1.581 11.597H3.635V9.67h3.283v10.782zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
        </svg>
        Connect on LinkedIn
        <svg class="ext-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        </svg>
        <span class="sr-only">(opens in new tab)</span>
      </a>

      <a
        href="https://github.com/lagliam"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-badge github-badge"
        aria-label="View GitHub profile (opens in new tab)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
        <svg class="ext-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        </svg>
        <span class="sr-only">(opens in new tab)</span>
      </a>

    </div>
  </div>
</section>
